# Backend Environment Variables
# Copy this file to .env and fill in the values.

# SECURITY: Generate a strong, random secret key for JWT signing.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# JWT token expiry in minutes (default: 120)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database connection URL (SQLite for local dev)
# For production, use PostgreSQL: postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./campus_booking.db

# CORS: Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
